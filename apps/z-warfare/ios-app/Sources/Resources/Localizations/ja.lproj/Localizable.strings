"synergy.18.description" = "カレッジユニットがゾンビを{SynergyTriggerConditionOnKilledByTeammate KillsRequired}体倒した時、ランダムなユニットがSynergyTriggerConditionOnKilledByTeammate KillsRaiseBy出現する。次のユニットを出現させるにはさらに{SynergyTriggerConditionOnKilledByTeammate KillsRaiseBy}体のキルと{SynergyEffectDamageModifierBySpawnIndex DamageModifier N%}ダメージが必要";
"synergy.19.description" = "3種類のユニークなメカニックが戦場に登場します。メカニックが出現するたびに、{SynergyTriggerActionSpawnCreatureNearBase TriggerChance N%}の可能性で砲塔が戦場に配置されます。ウェルダーが出現すると、その確率は{SynergyTriggerActionSpawnCreatureNearBase IncreasedChance %}に増加します。";
"synergy.2.description" = "メカニックが召喚されるたびにバスの体力が{SynergyTriggerActionRepairBase Value N%}イント回復します";
"synergy.20.description" = "砲塔の過熱によるダメージが{SynergyEffectSelfDamageModifier DamageModifier 1/N}倍低くなります";
"synergy.21.description" = "戦場に立つは3種類のビルダー。1回のバトルにつき、1ユニットがランダムに出現";
"synergy.22.description" = "戦場にあるドラム缶1つごとに全ビルダーのダメージが{SynergyEffectDamageModifierPerUnit DamageModifier N%}増加する。";
"synergy.23.description" = "3個性的ノーザナー戦場で。ノーザナーが出場後に命中させた最初の攻撃はすべてクリティカルになります";
"synergy.24.description" = "全ノーザナーのクリティカルダメージが{SynergyTriggerActionCreatureChangeStat Value N%}増加する。";
"synergy.25.description" = "いずれかのポリスが倒されると、戦場にいるすべてのポリスが{SynergyTriggerActionApplyEnhancedTeam Duration}秒間、レイジを獲得する";
"synergy.26.description" = "3体の異なるマリーンが戦場にいます。すべてのマリーンが最大値の素早さを獲得します。";
"synergy.27.description" = "すべてのマリーンの攻撃性を最大化する";
"synergy.28.description" = "3個性的IF戦場で。医療キットが {SynergyEffectSpawnMedKits MedkitSpawnCooldown} 秒ごとに戦場に現れます";
"synergy.29.description" = "医療キットの有効範囲内にいる敵へ、医療キットの回復力に等しい追加ダメージを与える。さらにその敵の移動速度を{SynergyEffectEnemySpeedModifierByMedkit Value -N%}低下させる";
"synergy.3.description" = "医療キットを戦場に{SynergyEffectMedkitHealDurationMultiplier HealDurationMultiplier}倍長く保持できます";
"synergy.30.description" = "ミリタリーの体力が{SynergyEffectStopReceivedDamageIfBelowHealth NormalHealthPercentMin N%}未満の場合、次に受けるダメージを{SynergyEffectStopReceivedDamageIfBelowHealth Chance N%}の確率で防ぐ";
"synergy.31.description" = "パトリオットが{SynergyTriggerActionIgnite TriggerChance N%}の確率で敵を燃焼状態にする";
"synergy.32.description" = "クリティカルヒットが出た時に追加のレイジポイントが{SynergyTriggerActionAddRage TriggerChance N%}で出ることがあります";
"synergy.33.description" = "3個性的サイコ戦場で。レイジポイントが出る度に、いずれかのユニットが激怒します";
"synergy.34.description" = "ミリタリーユニットは、敵が軍に所属していない場合、そのユニットが攻撃を行うまでは、攻撃を受けません";
"synergy.35.description" = "全TMFユニットが{SynergyEffectReceivedDamageModifier ModifierApplyChance N%}の確率で爆発ダメージを防ぐ";
"synergy.36.description" = "戦場に立つは3種類のTMF。1回のバトルにつき、1ユニットがランダムに出現";
"synergy.37.description" = "すべての燃焼状態の敵から受けるダメージが{SynergyEffectReceivedDamageModifier DamageModifier -N%}減少する";
"synergy.38.description" = "3人の看守が戦場へ。看守はクリティカルヒットを当てると、{SynergyTriggerActionStunTargetOrMakeNextAttackCritical TriggerChance N%}の確率で敵をスタンさせることができる";
"synergy.39.description" = "戦場にいる味方ユニットすべての体力が{SynergyEffectInitialHealthBonus HealthMultiplier %-1}増加する";
"synergy.4.description" = "戦場の全ユニットのマガジン容量が1ベースマガジン分増える（最大60）";
"synergy.40.description" = "戦場の3つのユニーク緊急サービスユニット。 医療キットの範囲内にいる味方全員のダメージが{SynergyEffectDamageModifierByMedkit DamageModifier N%}追加される";
"synergy.41.description" = "{SynergyTriggerConditionHeal UnitsCount}ユニットを回復するたびに、ランダムなユニットが1出現する";
"synergy.42.description" = "戦場に3人の異なった科学者がいる。ドローンは科学者の1人が殺されたユニットを攻撃する。";
"synergy.43.description" = "同じゾンビを倒すごとに、ゾンビへのダメージが{SynergyEffectDamageModifierPerCreatureType DamageModifier N%}増加する";
"synergy.44.description" = "爆発によるダメージが{SynergyEffectReceivedDamageModifier DamageModifier N%}増加する";
"synergy.45.description" = "すべての囚人の近接ダメージ耐性が{SynergyTriggerActionSetDamageResist ResistValue N%}上がる";
"synergy.46.description" = "戦場に3人の異なる囚人がいると発動。すべての囚人が、{SynergyEffectFirstReceivedDamageModifier ModifierApplyChance N%}の確率で敵の初撃を防ぐ";
"synergy.47.description" = "最前列のユニットが体力{SynergyEffectAddShieldToVanguard ShieldHPRatio N%}に相当するシールドを得る";
"synergy.48.description" = "戦場に個性あふれる3人のサザナーズが登場。サザナーズの1人が倒れると、残りユニットの体力が倒れた1人の体力の{SynergyTriggerActionHealTeam HealAmount N%}分回復する";
"synergy.49.description" = "サザナーズが戦場に出ると、ダメージが{SynergyTriggerActionCreatureDamageModifierByWaterLevel GuaranteedDamageModifier N%}増加し、蓄積された勇気{SynergyTriggerActionCreatureDamageModifierByWaterLevel WaterLevelStep}ごとにさらに{SynergyTriggerActionCreatureDamageModifierByWaterLevel DamageModifierForEachStep N%}ダメージが増加する。";
"synergy.5.description" = "3個性的ポリス戦場で。3人目のポリスマンとその後出場するすべてのポリスは、最大体力の{SynergyTriggerActionSetShieldRelativeToHp ShieldToHealthRatio N%}のシールドを手に入れます";
"synergy.50.description" = "全デリバリーユニットが{SynergyEffectStopReceivedDamage Chance N%}の確率で被ダメージを防ぐ";
"synergy.51.description" = "戦場に3人のデリバリーユニットが展開。同じ目標を攻撃しているデリバリーユニット1体ごとにダメージが{SynergyEffectDamageModifierOnEnemyHitToSetUnits DamageModifier N%}増加します。";
"synergy.52.description" = "敵にかかっているマイナス効果の数が増えるごとに、囚人の与ダメージが{SynergyEffectDamageModifierPerNegativeEffect DamageModifier N%}増える";
"synergy.53.description" = "被ダメージを防いだ後、{SynergyTriggerActionNextAttackDamageModifier TriggerChance N%}の確率で次の攻撃ダメージが{SynergyTriggerActionNextAttackDamageModifier DamageModifier N%}増加する";
"synergy.6.description" = "バスの前に赤いドラム缶と窒素が配置される。その他のモードでは、代わりに赤いドラム缶2つが戦場に配置される";
"synergy.7.description" = "TMFユニットが出た時に、いずれかのユニットのコストが、{SynergyTriggerActionChangeRandomUnitHireCost TriggerChance N%}の確率で、{SynergyTriggerActionChangeRandomUnitHireCost CostDelta -int}減少する。1回のバトルにつき{SynergyTriggerActionChangeRandomUnitHireCost MaxActivationsCountPerBattle}回まで";
"synergy.8.description" = "ゾンビが死ぬと、{SynergyTriggerActionAddRage TriggerChance N%} の確率で追加のレイジポイントがドロップされます";
"synergy.9.description" = "3個性的パトリオット戦場で。燃焼ダメージが {SynergyEffectReceivedDamageModifier DamageModifier N%} 増加する";
