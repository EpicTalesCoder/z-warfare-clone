"synergy.0.description" = "支持物品的准备时间减少{SynergyEffectSpawnCooldown MultiplySpawnCooldown (1-FloatMult)%}";
"synergy.1.description" = "所有单位的准备时间减少 {SynergyEffectSpawnCooldown MultiplySpawnCooldown (1-FloatMult)%}";
"synergy.10.description" = "战场上的3名独特军人。当这些军人中的2人被击败时，特种部队将会有{SynergyTriggerActionSpawnCreatureNearBase TriggerChance N%}的几率被派遣到战场上";
"synergy.11.description" = "每有{SynergyEffectCritDamageModifier PerStatValue}点魅力，暴击伤害增加{SynergyEffectCritDamageModifier DeltaValue N%}";
"synergy.12.description" = "二等兵罗德里格斯有{SynergyTriggerActionActivateAgilityAggressionCombo TriggerChance N%}的机会获得最大敏捷度和攻击性";
"synergy.13.description" = "北方佬在杀死一名敌人后一定会使出致命一击";
"synergy.14.description" = "当一个红脖子受伤时，有{SynergyTriggerActionSpawnLootNearUnit TriggerChance N%}的几率掉落额外勇气值";
"synergy.15.description" = "3独特红脖子在战场上。当一个随机的红脖子获得额外勇气值时，他将回复100%的生命值";
"synergy.16.description" = "当一个村夫阵亡时，有{SynergyTriggerActionSpawnLootNearUnit TriggerChance N%}的几率掉落额外勇气值";
"synergy.17.description" = "战场上有3个独特大学单位。大学单位的魅力增加{SynergyEffectAddBDMorale BDMoraleMultiplier %-1}";
"synergy.18.description" = "当大学单位击杀{SynergyTriggerConditionOnKilledByTeammate KillsRequired}个僵尸后，会出现一个随机单位。每个后续单位需要额外{SynergyTriggerConditionOnKilledByTeammate KillsRaiseBy}次击杀和额外造成{SynergyEffectDamageModifierBySpawnIndex DamageModifier N%}伤害。";
"synergy.19.description" = "战场上有3个独特机械师。每次机械师出现时，有{SynergyTriggerActionSpawnCreatureNearBase TriggerChance N%}的几率在战场上放置一个炮塔。每次电焊工出现时，几率增加到{SynergyTriggerActionSpawnCreatureNearBase IncreasedChance %}。";
"synergy.2.description" = "每次机械师出现时，巴士的生命值恢复{SynergyTriggerActionRepairBase Value N%}";
"synergy.20.description" = "过热炮塔造成的伤害会降低{SynergyEffectSelfDamageModifier DamageModifier 1/N}倍";
"synergy.21.description" = "战场上有3个独特建筑工人。一个随机单位进入战场，每场战斗一次";
"synergy.22.description" = "战场上每存在一个油桶，所有建筑工人的伤害提高{SynergyEffectDamageModifierPerUnit DamageModifier N%}";
"synergy.23.description" = "3独特北方佬在战场上。北方佬出现后的第一次攻击一定是致命一击";
"synergy.24.description" = "所有北方佬的暴击伤害提高{SynergyTriggerActionCreatureChangeStat Value N%}";
"synergy.25.description" = "在任意警察单位死亡后，战场上的所有警察单位获得怒气，持续{SynergyTriggerActionApplyEnhancedTeam Duration}秒。";
"synergy.26.description" = "战场上的3名独特海军陆战队员。所有海军陆战队员都会获得最高敏捷度";
"synergy.27.description" = "所有海军陆战队员均会获得最大攻击性";
"synergy.28.description" = "3独特内部力量在战场上。每隔 {SynergyEffectSpawnMedKits MedkitSpawnCooldown} 秒，战场上就会出现一个急救包";
"synergy.29.description" = "处于医药箱范围内的敌人会受到与医药箱治愈力相等的额外伤害，同时其移动速度降低{SynergyEffectEnemySpeedModifierByMedkit Value -N%}";
"synergy.3.description" = "医药箱在战场上的停留时间延长{SynergyEffectMedkitHealDurationMultiplier HealDurationMultiplier}倍";
"synergy.30.description" = "如果军人的生命值低于{SynergyEffectStopReceivedDamageIfBelowHealth NormalHealthPercentMin N%}，则他有{SynergyEffectStopReceivedDamageIfBelowHealth Chance N%}的几率躲避下一次伤害";
"synergy.31.description" = "爱国者有{SynergyTriggerActionIgnite TriggerChance N%}的几率点燃敌人";
"synergy.32.description" = "当打出致命一击时，有{SynergyTriggerActionAddRage TriggerChance N%}的几率掉落额外怒气值";
"synergy.33.description" = "3独特精神病人在战场上。每当怒气值掉落时，将有一个随机单位获得狂怒";
"synergy.34.description" = "如果敌人不是军人，则一个军人单位只有在自己主动发动攻击时才会受到攻击";
"synergy.35.description" = "所有TMF单位都有{SynergyEffectReceivedDamageModifier ModifierApplyChance N%}的几率抵挡爆炸伤害";
"synergy.36.description" = "战场上有3个独特TMF单位。一个随机单位进入战场，每场战斗一次";
"synergy.37.description" = "所有燃烧中的敌人造成的伤害降低{SynergyEffectReceivedDamageModifier DamageModifier -N%}。";
"synergy.38.description" = "3个独特狱卒在战场上。所有狱卒有{SynergyTriggerActionStunTargetOrMakeNextAttackCritical TriggerChance N%}的几率在打出暴击后击晕敌人";
"synergy.39.description" = "战场上所有盟友单位的生命值增加{SynergyEffectInitialHealthBonus HealthMultiplier %-1}";
"synergy.4.description" = "战场上所有单位的弹匣容量增加一个基础弹匣，最多60";
"synergy.40.description" = "战场上有3个独特紧急服务单位。医药箱半径范围内的所有盟友造成的伤害将添加{SynergyEffectDamageModifierByMedkit DamageModifier N%}";
"synergy.41.description" = "每治疗{SynergyTriggerConditionHeal UnitsCount}个单位，会出现一个随机单位";
"synergy.42.description" = "战场上有3名独特科学家。无人机攻击了杀死其中一名科学家的单位。";
"synergy.43.description" = "每次击杀同一僵尸，对僵尸的伤害增加{SynergyEffectDamageModifierPerCreatureType DamageModifier N%}";
"synergy.44.description" = "爆炸伤害增加{SynergyEffectReceivedDamageModifier DamageModifier N%}";
"synergy.45.description" = "所有囚徒的近战伤害抗性提高{SynergyTriggerActionSetDamageResist ResistValue N%}";
"synergy.46.description" = "战场上有3名不同的囚徒时，所有囚徒都有{SynergyEffectFirstReceivedDamageModifier ModifierApplyChance N%}的几率抵挡每名敌人的首次攻击";
"synergy.47.description" = "位于最前面的单位获得一个相当于其生命值{SynergyEffectAddShieldToVanguard ShieldHPRatio N%}的护盾。";
"synergy.48.description" = "3名独特南方佬在战场上。只要有一个南方佬死亡，所有结盟单位的生命值均会恢复被打败单位生命值的{SynergyTriggerActionHealTeam HealAmount N%}。";
"synergy.49.description" = "每当南方佬上场时，获得{SynergyTriggerActionCreatureDamageModifierByWaterLevel GuaranteedDamageModifier N%}点伤害，并在每累积{SynergyTriggerActionCreatureDamageModifierByWaterLevel WaterLevelStep}点勇气时额外提高{SynergyTriggerActionCreatureDamageModifierByWaterLevel DamageModifierForEachStep N%}点伤害。";
"synergy.5.description" = "3独特警察在战场上。第三名以及所有之后出现的警察都会获得一个相当于他们最大生命值{SynergyTriggerActionSetShieldRelativeToHp ShieldToHealthRatio N%}的护盾";
"synergy.50.description" = "所有快递单位有{SynergyEffectStopReceivedDamage Chance N%}的几率可以忽略伤害";
"synergy.51.description" = "战场上有3个独特快递单位。每有一个投送单位攻击同一目标，伤害增加{SynergyEffectDamageModifierOnEnemyHitToSetUnits DamageModifier N%}。";
"synergy.52.description" = "每向敌人施加一次负面效果，囚徒额外造成{SynergyEffectDamageModifierPerNegativeEffect DamageModifier N%}伤害";
"synergy.53.description" = "抵挡一次受到的伤害后，下一次攻击有{SynergyTriggerActionNextAttackDamageModifier TriggerChance N%}的几率额外造成{SynergyTriggerActionNextAttackDamageModifier DamageModifier N%}伤害";
"synergy.6.description" = "在大巴前放置一个红色油桶和一个液氮瓶。在其他模式中，会改为在战场上放置两个红色油桶。";
"synergy.7.description" = "任何TMF单位出现时，有{SynergyTriggerActionChangeRandomUnitHireCost TriggerChance N%}的几率会有一个随机单位的成本降低{SynergyTriggerActionChangeRandomUnitHireCost CostDelta -int}。每场战斗仅限{SynergyTriggerActionChangeRandomUnitHireCost MaxActivationsCountPerBattle}次";
"synergy.8.description" = "当任何僵尸死亡时，有 {SynergyTriggerActionAddRage TriggerChance N%} 的几率带来额外的怒火值";
"synergy.9.description" = "3独特爱国者在战场上。燃烧伤害提升{SynergyEffectReceivedDamageModifier DamageModifier N%}";
